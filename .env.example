# Copy to .env (not committed). These are the variables the default config/agents.toml refers to;
# change the *_env names in config/agents.local.toml if your machine uses different ones.
# Alternatively list an existing dotenv file in config/settings.local.toml: env_files = ["~/path/.env"].

# Backend "local": an OpenAI-compatible server for bulk work (tagging, routing, extraction).
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_API_KEY=sk-local

# Backend "gateway": an OpenAI-compatible gateway or provider for answer generation.
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=sk-your-key

# GitHub API token for the question-repository connector (optional: falls back to `gh auth token`).
# GITHUB_TOKEN=ghp_...

# Telegram alerts (only when [notify] channels includes "telegram").
# TELEGRAM_BOT_TOKEN=123456:ABC
# TELEGRAM_CHAT_ID=123456789
